---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<footer class="footer container">
	<div class="footer__row">
		<p class="footer__copy">&copy; <span data-year>{new Date().getFullYear()}</span> {SITE_TITLE}</p>
		<nav class="footer__links" aria-label="Footer">
			{SOCIAL_LINKS.map(({ label, href }) => (
				<a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
			))}
			<a href="#top" data-anchor aria-label="Back to top">↑&nbsp;Top</a>
		</nav>
	</div>
</footer>

<script>
	// Keep the year current between deploys.
	const yearEl = document.querySelector<HTMLElement>('[data-year]');
	if (yearEl) yearEl.textContent = new Date().getFullYear().toString();
</script>

<style>
	.footer {
		padding-bottom: var(--space-xs);
	}

	.footer__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		column-gap: var(--space-sm);
		box-shadow: inset 0 var(--rule-weight) rgb(var(--black));
		font-size: var(--type-meta);
		line-height: var(--lh-meta);
	}

	/* Padded to the links' 44px row height so the text keeps its distance
	   from the rule when the row wraps on phones. (Not flex — that would
	   collapse the spaces around the year span.) */
	.footer__copy {
		margin: 0;
		padding-block: calc((44px - 1.4em) / 2);
		padding-block: calc((44px - 1lh) / 2);
	}

	.footer__links {
		display: flex;
		gap: var(--space-sm);
	}

	.footer__links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
</style>
