---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<header class="masthead container" id="top">
	<div class="masthead__bar" data-intro="bar">
		<p class="masthead__place">Boston, MA</p>
		<nav class="masthead__links" aria-label="Elsewhere">
			{SOCIAL_LINKS.map(({ label, href }) => (
				<a href={href} target="_blank" rel="noopener noreferrer">
					{label}<span class="arrow" aria-hidden="true">→</span>
				</a>
			))}
		</nav>
	</div>

	<div>
		<h1 class="name" data-intro="name">{SITE_TITLE}</h1>
		<span class="rule" aria-hidden="true" data-intro="rule"></span>
	</div>
</header>

<style>
	/* The masthead is the whole first screen: small info bar on top, the
	   name sitting on a rule at the bottom. It scrolls with the page like
	   any other block — nothing here is fixed or scroll-driven. */
	.masthead {
		/* Lets .name size itself against this box's content width (cqi). */
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-xl);
		min-height: 100vh;
		min-height: 100svh;
		padding-block: var(--space-xs) var(--space-md);
	}

	.masthead__bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-xs);
		font-size: var(--type-meta);
		line-height: var(--lh-meta);
	}

	.masthead__place {
		margin: 0;
	}

	.masthead__links {
		display: flex;
		gap: var(--space-sm);
	}

	.masthead__links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
	}

	/* Sized so the full name spans the content width on one line:
	   font-size = container width ÷ (name width in em). --name-fit comes
	   from tokens.css; phones override it below to fit "LETTERIO" so the
	   name breaks onto two lines at the space. The negative margin cancels
	   the M/L side bearing (0.084em) so the ink sits on the gutter. */
	.name {
		margin: 0 0 0 -0.084em;
		font-size: 10vw;
		font-size: calc(100cqi / var(--name-fit));
		font-weight: var(--font-weight-bold);
		line-height: var(--lh-display);
		letter-spacing: -0.03em;
		text-transform: uppercase;
		white-space: nowrap;
		overflow-wrap: normal;
	}

	.rule {
		display: block;
		height: var(--rule-weight);
		margin-top: var(--space-sm);
		background: rgb(var(--black));
		transform-origin: left center;
	}

	@media (max-width: 640px) {
		.name {
			/* "LETTERIO" ink is 4.505em; the slack keeps its advance
			   width inside the line box so it never overflows. */
			--name-fit: 4.53;
			white-space: normal;
		}
	}
</style>
