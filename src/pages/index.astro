---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div id="smooth-wrapper">
			<div id="smooth-content">
				<Header />

				<main>
					{/* Sections are numbered and labelled from SECTIONS in src/consts.ts. */}
					<Section id="about">
						{/* TODO(bio): replace with your own 2–3 sentences (~40–60 words). */}
						<p data-reveal>
							Hey there, I'm Michael: skier, traveler, photographer, and weekend sailor.
							A curious, detail-oriented engineer with a knack for creative problem solving.
							I build machine vision systems, currently pursuing an
							MS in Data Science at Boston University.
						</p>
					</Section>

					<Section id="work">
						{/* When ready, swap this for <IndexList rows={WORK} /> (rows live in src/consts.ts). */}
						<p data-reveal>Coming soon.</p>
					</Section>
				</main>

				<Footer />
			</div>
		</div>

		<script>
			import '../scripts/animations.ts';
		</script>
	</body>
</html>
